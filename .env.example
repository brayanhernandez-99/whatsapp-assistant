# ==========================================
# WhatsApp Assistant
# Variables de entorno
# ==========================================

# Entorno de ejecución
NODE_ENV=development

# Nombre del bot
BOT_NAME=WhatsApp Assistant

# Prefijo para comandos (opcional)
BOT_PREFIX=!

# Nivel de logs
LOG_LEVEL=info

# Zona horaria
TZ=America/Bogota
